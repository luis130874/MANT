            if not df_ot_actual.empty:
                pendientes_ot = df_ot_actual[(df_ot_actual['cliente'].astype(str).str.strip() == str(emp_g).strip()) & (df_ot_actual['estado'].astype(str).str.strip() == "Pendiente")]
                if not pendientes_ot.empty:
                    st.markdown("---")
