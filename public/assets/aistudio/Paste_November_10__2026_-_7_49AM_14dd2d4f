def leer_csv(archivo, cols):
    try:
        content = repo_gh.get_contents(archivo)
        df = pd.read_csv(io.StringIO(base64.b64decode(content.content).decode('utf-8'))).astype(str)
        return df.loc[:, ~df.columns.str.contains('^Unnamed')]
    except Exception:
        return pd.DataFrame(columns=cols)

def guardar_csv(df, archivo, msg):
    try:
        old = repo_gh.get_contents(archivo)
        repo_gh.update_file(old.path, msg, df.to_csv(index=False), old.sha)
    except Exception:
        try:
            repo_gh.create_file(archivo, msg, df.to_csv(index=False))
        except Exception as e2:
            st.error(f"❌ Error al crear/sincronizar {archivo}: {e2}")

