def obtener_frecuencia_config(frecuencia_str):
    match = df_freq[df_freq['nombre_freq'].astype(str).str.strip() == str(frecuencia_str).strip()]
    if not match.empty:
        try:
            paso_val = int(float(match.iloc[0]['paso_meses']))
            tol_val = int(float(match.iloc[0]['dias_tolerancia']))
            return paso_val, tol_val
        except:
            pass
    freq_lower = str(frecuencia_str).strip().lower()
    if "diaria" in freq_lower:
        return 0, 1
    elif "semanal" in freq_lower:
        return 0, 1
    elif "quincenal" in freq_lower:
        return 0, 2
    mapping = {"mensual": 1, "trimestral": 3, "semestral": 6, "anual": 12}
    return mapping.get(freq_lower, 1), 4

def obtener_paso(frecuencia_str):
    p, _ = obtener_frecuencia_config(frecuencia_str)
    return p

def obtener_tolerancia(frecuencia_str):
    _, t = obtener_frecuencia_config(frecuencia_str)
    return t

