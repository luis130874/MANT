def calcular_ocurrencias_equipo(eq, anio=2026):
    freq_str = str(eq.get('frecuencia', 'Mensual')).strip()
    freq_lower = freq_str.lower()
    f_i = pd.to_datetime(eq.get('fecha_proxima'), errors='coerce')
    
    inicio_dt = f_i.date() if pd.notnull(f_i) else datetime(anio, 1, 1).date()
    fin_anio = datetime(anio, 12, 31).date()
    ocurrencias = []
    
    if "diaria" in freq_lower:
        curr = max(inicio_dt, datetime(anio, 1, 1).date())
        while curr <= fin_anio:
            ocurrencias.append({'fecha': curr, 'mes_n': curr.month, 'seq_key': curr.strftime('%Y%m%d')})
            curr += timedelta(days=1)
    elif "semanal" in freq_lower:
        curr = max(inicio_dt, datetime(anio, 1, 1).date())
        while curr <= fin_anio:
            ocurrencias.append({'fecha': curr, 'mes_n': curr.month, 'seq_key': curr.strftime('%Y%m%d')})
            curr += timedelta(days=7)
    elif "quincenal" in freq_lower:
        curr = max(inicio_dt, datetime(anio, 1, 1).date())
        while curr <= fin_anio:
            ocurrencias.append({'fecha': curr, 'mes_n': curr.month, 'seq_key': curr.strftime('%Y%m%d')})
            curr += timedelta(days=14)
    else:
        paso, _ = obtener_frecuencia_config(freq_str)
        if paso < 1: paso = 1
        mes_inicio = inicio_dt.month if inicio_dt.year == anio else 1
        dia_base = inicio_dt.day if 1 <= inicio_dt.day <= 28 else 15
        
        m = mes_inicio
        while m <= 12:
            try: dt_oc = datetime(anio, m, dia_base).date()
            except: dt_oc = datetime(anio, m, 28).date()
            if datetime(anio, 1, 1).date() <= dt_oc <= fin_anio:
                ocurrencias.append({'fecha': dt_oc, 'mes_n': m, 'seq_key': f"{m:02d}"})
            m += paso
            
    return ocurrencias

def generar_mapa_folios_anual(df_equipos, anio=2026):
    mapa = {}
    if df_equipos.empty: return mapa
    df_sorted = df_equipos.sort_values('codigo_eq').reset_index(drop=True)
    contadores_mes = {m: 1 for m in range(1, 13)}
    
    for _, eq in df_sorted.iterrows():
        eq_code = str(eq['codigo_eq']).strip()
        occurs = calcular_ocurrencias_equipo(eq, anio)
        for occ in occurs:
            m = occ['mes_n']
            corr = contadores_mes[m]
            folio = generar_folio_mp(m, corr, anio)
            mapa[(eq_code, occ['fecha'])] = folio
            mapa[(eq_code, occ['seq_key'])] = folio
            contadores_mes[m] += 1
            
    return mapa

