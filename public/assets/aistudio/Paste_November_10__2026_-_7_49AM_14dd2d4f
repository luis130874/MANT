            if not df_ot_actual.empty:
                cerradas_ot_emp = df_ot_actual[(df_ot_actual['cliente'].astype(str).str.strip() == str(emp_g).strip()) & (df_ot_actual['estado'].astype(str).str.startswith("Cerrada"))]
                if not cerradas_ot_emp.empty: st.dataframe(cerradas_ot_emp, use_container_width=True, hide_index=True)
