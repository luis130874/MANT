                grouped_by_month.setdefault(m, []).append(occ)

            max_occurs_in_month = max([len(v) for v in grouped_by_month.values()]) if grouped_by_month else 1

            for sub_i in range(max_occurs_in_month):
                suffix_tag = f" #{sub_i+1}" if max_occurs_in_month > 1 else ""
                f1 = {"ID": eq_code, "Equipo": f"{str(eq['nombre'])}{suffix_tag}", "Frecuencia": freq_val, "Detalle": "Fecha Prevista"}
