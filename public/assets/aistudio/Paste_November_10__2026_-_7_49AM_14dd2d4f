                                self.set_font("Arial", "B", 15)
                                self.cell(0, 10, "ORDEN DE TRABAJO (MEJORA / INSTALACIÓN)", ln=1)
                                self.set_font("Arial", "B", 11)
                                self.cell(0, 7, f"FOLIO: {self.folio_ot}", ln=1)
                                self.ln(5)
                            def footer(self):
                                self.set_y(-18)
                                self.set_font("Arial", "", 9)
                                self.cell(0, 5, "Técnico Responsable: _________________________     Firma: ___________________", ln=1, align="C")
                                self.set_font("Arial", "I", 8)
                                self.set_text_color(100)
                                self.cell(0, 5, 'Página 1 / 1', 0, 0, 'R')

                        def generar_pdf_ot(r_p, eq_nombre, t_asig):
                            pdf = PDFOTMultiPage(r_p['id_ot'])
                            pdf.set_auto_page_break(auto=True, margin=15)
                            pdf.add_page()
                            pdf.set_font("Arial", "", 10)
                            pdf.cell(0, 6, f"Cliente: {r_p['cliente']} | Fecha Emisión: {r_p['fecha_emision']}", ln=1)
                            pdf.cell(0, 6, f"Fecha Tentativa Compromiso: {r_p.get('fecha_tentativa', 'N/D')} (Tolerancia: {r_p.get('dias_tolerancia', '0')} días)", ln=1)
                            pdf.cell(0, 6, f"Ubicación / Equipo ID: {r_p['codigo_eq']} - {eq_nombre} | Asignado: {t_asig}", ln=1)
                            pdf.ln(5)
                            pdf.set_font("Arial", "B", 10)
                            pdf.cell(0, 6, "DESCRIPCIÓN DEL TRABAJO SOLICITADO:", ln=1)
                            pdf.set_font("Arial", "", 10)
                            for l_t in str(r_p['trabajo_solicitado']).splitlines():
                                l_clean = limpiar_t(l_t.strip())
                                if l_clean: pdf.cell(190, 6, f"- {l_clean}", ln=1)
                            pdf.ln(5)
                            pdf.set_font("Arial", "B", 10)
                            pdf.cell(0, 6, "ACCIONES REALIZADAS / MATERIALES UTILIZADOS:", ln=1)
                            pdf.ln(2)
                            y_start = pdf.get_y()
                            pdf.rect(10, y_start, 190, 80)
                            return bytes(pdf.output())

                        col_d1, col_d2 = st.columns([3, 1])
                        col_d1.write(f"**{row_p['id_ot']}** - Equipo: {nom_eq_str} | Asignado: {tec_asig_txt} | Trabajo: {row_p['trabajo_solicitado'][:30]}...")
                        col_d2.download_button("📥 DESCARGAR PDF", data=generar_pdf_ot(row_p, nom_eq_str, tec_asig_txt), file_name=f"OT_{row_p['id_ot']}.pdf", mime="application/pdf", key=f"btn_dl_ot_{row_p['id_ot']}")
                        
        elif sub_t_ot == "✅ Cierre de OT":
            st.markdown("### Cierre de Órdenes de Trabajo Ejecutadas")
            if not df_ot_actual.empty:
                pendientes_ot_cierre = df_ot_actual[(df_ot_actual['cliente'].astype(str).str.strip() == str(emp_g).strip()) & (df_ot_actual['estado'].astype(str).str.strip() == "Pendiente")]
                if not pendientes_ot_cierre.empty:
                    opts_cierre_ot = [f"{r['id_ot']} | Asignado: {r.get('tecnico','N/D')} | {r['trabajo_solicitado'][:30]}" for _, r in pendientes_ot_cierre.iterrows()]
                    with st.form("f_cierre_ot"):
                        sel_cierre_ot_lbl = st.selectbox("Seleccione Orden de Trabajo Pendiente:", opts_cierre_ot)
                        ot_sel_id = sel_cierre_ot_lbl.split(" | ")[0]
                        
                        row_ot_match = pendientes_ot_cierre[pendientes_ot_cierre['id_ot'].astype(str).str.strip() == ot_sel_id]
                        tec_sugerido_ot = row_ot_match.iloc[0].get('tecnico', '') if not row_ot_match.empty else ""
                        idx_def_tec_ot = lista_tecnicos_activos.index(tec_sugerido_ot) if tec_sugerido_ot in lista_tecnicos_activos else 0

                        c1, c2 = st.columns(2)
                        f_real_ot = c1.date_input("Fecha Real de Finalización", value=datetime.now())
                        tec_ot = c2.selectbox("Técnico / Responsable Ejecutor (Confirmar/Reasignar)", lista_tecnicos_activos, index=idx_def_tec_ot)
                        acc_realizadas_ot = st.text_area("Acciones Realizadas / Materiales Utilizados")
                        
                        if st.form_submit_button("REGISTRAR CIERRE OT"):
                            if tec_ot and "Sin Técnicos" not in tec_ot and acc_realizadas_ot.strip():
                                idx_row = df_ot_actual[df_ot_actual['id_ot'].astype(str).str.strip() == ot_sel_id].index
                                if not idx_row.empty:
                                    f_tent_str = df_ot_actual.loc[idx_row, 'fecha_tentativa'].iloc[0]
                                    d_tol_val = int(float(df_ot_actual.loc[idx_row, 'dias_tolerancia'].iloc[0]))
                                    
                                    f_tent_dt = pd.to_datetime(f_tent_str, format="%d/%m/%Y", errors='coerce')
                                    estado_cumplimiento = "Cerrada"
                                    if pd.notnull(f_tent_dt):
                                        dif_dias_ot = (f_real_ot - f_tent_dt.date()).days
                                        if dif_dias_ot <= d_tol_val: estado_cumplimiento = "Cerrada (A tiempo)"
                                        else: estado_cumplimiento = "Cerrada (Fuera de término)"

                                    df_ot_actual.loc[idx_row, 'estado'] = estado_cumplimiento
                                    df_ot_actual.loc[idx_row, 'fecha_real'] = f_real_ot.strftime("%d/%m/%Y")
                                    df_ot_actual.loc[idx_row, 'acciones_realizadas'] = acc_realizadas_ot
                                    df_ot_actual.loc[idx_row, 'tecnico'] = tec_ot
                                    
                                    guardar_csv(df_ot_actual, "ordenes_trabajo.csv", f"Cierre OT {ot_sel_id}")
                                    st.toast(f"✅ ¡Orden de Trabajo {ot_sel_id} cerrada con éxito!", icon="🎉")
                                    st.success(f"✅ ¡Orden de Trabajo **{ot_sel_id}** cerrada como **{estado_cumplimiento}** por el técnico **{tec_ot}**!")
                                    st.rerun()
                            else: st.warning("Por favor, seleccione un técnico válido y describa las acciones realizadas.")
                else: st.info("No hay órdenes de trabajo pendientes de cierre para esta empresa.")
            else: st.info("No hay registros de órdenes de trabajo.")
        else:
