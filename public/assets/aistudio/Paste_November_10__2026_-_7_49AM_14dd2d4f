                        tec_asig_txt = row_p.get('tecnico', 'Sin asignar')
                        
                        class PDFOTMultiPage(FPDF):
                            def __init__(self, folio_ot):
                                super().__init__()
                                self.folio_ot = folio_ot
                            def header(self):
                                if logo_f: 
                                    try: self.image(logo_f, 155, 10, 40)
