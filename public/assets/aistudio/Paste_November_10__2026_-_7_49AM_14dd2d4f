                f3 = {"ID": "", "Equipo": "", "Frecuencia": "", "Detalle": "ID de Orden"}

                for m_idx in range(1, 13):
                    m_label = MESES_L[m_idx - 1]
                    list_m = grouped_by_month.get(m_idx, [])
                    if sub_i < len(list_m):
                        occ_item = list_m[sub_i]
                        dt_prev = occ_item['fecha']
                        f1[m_label] = dt_prev.strftime("%d/%m/%Y")
                        fol_id = mapa_folios_global.get((eq_code, dt_prev), generar_folio_mp(m_idx, 1))
                        f3[m_label] = fol_id
                        f2[m_label] = dict_fechas.get(fol_id, "")
